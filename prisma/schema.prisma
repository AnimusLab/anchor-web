datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrgType {
  ENTERPRISE
  REGULATORY_BODY
}

enum ContractTier {
  STARTER
  BASE_ENTERPRISE
  GROWTH
  SOVEREIGN
}

enum PackageTier {
  LAUNCH
  STARTER
  PROFESSIONAL
  GROWTH
  SOVEREIGN
}

enum EntitlementType {
  ADDITIVE
  REPLACEMENT
  VALUE
  BOOLEAN
}

enum EntitlementScope {
  ORGANIZATION
  HUB
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  EXPIRED
  SUPERSEDED
}

enum ContractStatus {
  DRAFT
  AWAITING_CUSTOMER_SIGNATURE
  AWAITING_ANIMUSLAB_SIGNATURE
  EXECUTED
  AMENDED
  TERMINATED
  EXPIRED
}

enum PaymentStatus {
  NOT_DUE
  INVOICED
  PARTIALLY_PAID
  PAID
  OVERDUE
  REFUNDED
}

enum EntitlementStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum ModelStatus {
  PENDING
  ACTIVE
  QUARANTINED
  ARCHIVED
  REJECTED
}

enum Role {
  HUB_MANAGER
  PROJECT_LEAD
  DEVELOPER
  STANDARD_AUDITOR
  CROSS_HUB_AUDITOR
  REGULATORY_AUDITOR
}

enum AdminRole {
  ANIMUS_ADMIN
  ANIMUS_ENGINEER
}

enum UserStatus {
  PENDING
  APPROVED
  REVOKED
}

enum EntityType {
  AI_AGENT
  CODEBASE
  GATEWAY
  MESH_NODE
}

enum VisibilityClass {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
  EXPIRED
}

enum NoticeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InviteStatus {
  SENT
  ACCEPTED
  EXPIRED
}

model Organization {
  id           String       @id // e.g. "jpmc" or "rbi"
  displayName  String
  domain       String       @unique // e.g. "jpmc.com" or "rbi.org.in"
  orgType      OrgType      @default(ENTERPRISE)
  region       String       @default("GL")
  contractTier ContractTier?
  status       UserStatus   @default(APPROVED)
  createdAt    DateTime     @default(now())

  hubs         Hub[]
  users        User[]
  whitelists   Whitelist[]
  invites      OrgInvite[]
  quotes       Quote[]
  contracts    Contract[]
  entitlements EntitlementGrant[]
  onboardingInvitations OnboardingInvitation[]
}

model Hub {
  id                 String           @id // e.g. "JPMC-IN-MUM01"
  orgId              String
  organization       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  displayName        String
  region             String
  unit               String           @default("MUM01")
  apiKeyHash         String           @unique
  entityType         EntityType       @default(AI_AGENT)
  visibilityClass    VisibilityClass  @default(INTERNAL)
  regulatoryVisible  Boolean          @default(true)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())

  projects           Project[]
  apiKeys            ApiKey[]
  users              User[]
  userAssignments    UserHubAssignment[]
  ledgerEntries      LedgerEntry[]
  telemetryEvents    TelemetryEvent[]
  enforcementNotices EnforcementNotice[]
  accessRequests     GovernanceAccessRequest[]
  identities         GovernanceIdentity[]
  whitelists         Whitelist[]
  invites            OrgInvite[]
  governedModels     GovernedAiModel[]
  entitlements       EntitlementGrant[]
}

model Project {
  id            String   @id @default(cuid())
  hubId         String
  hub           Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  apiKeyHash    String   @unique
  createdAt     DateTime @default(now())

  users         User[]
  apiKeys       ApiKey[]
  modelBindings ProjectModelBinding[]
  scanEvents    ProjectScanEvent[]

  @@unique([hubId, slug])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String    // e.g. "anc_live_8f92"
  keyHash     String    @unique // SHA-256 hash of raw key
  hubId       String
  hub         Hub       @relation(fields: [hubId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  role        Role      @default(DEVELOPER)
  scope       String    @default("INGEST_ONLY") // "INGEST_ONLY" | "FULL_ACCESS" | "ADMIN_KEY"
  createdBy   String?   // User clearance ID
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
}

model User {
  id           String     @id // Clearance ID format: [NAME]-[ROLE]-[LEVEL] (e.g. "TAN-MGR-L3", "SAM-DEV-L1", "ALE-CH-L4")
  email        String     @unique
  displayName  String
  role         Role
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  hubId        String?    // Required for HUB_MANAGER, PROJECT_LEAD, DEVELOPER, STANDARD_AUDITOR
  hub          Hub?       @relation(fields: [hubId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  jurisdiction String?    // e.g. "RBI", "SEC", "FCA", "EU"
  totpSecret   String?
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())

  hubAssignments     UserHubAssignment[]
  requestsMade       GovernanceAccessRequest[] @relation("Requester")
  requestsApproved   GovernanceAccessRequest[] @relation("Approver")
  replayLogs         ReplayAccessLog[]
  noticesIssued      EnforcementNotice[]
  enterpriseAuditLogs AuditTrail[]
  auditorAuditLogs    AuditorTrail[]
}

model UserHubAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hubId     String
  hub       Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  grantedBy String?  // AdminUser ID
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  reason    String?

  @@unique([userId, hubId])
}

model AdminUser {
  id          String     @id // Root Admin Clearance ID format: [NAME]-ADM-L5 (e.g. "TAN-ADM-L5")
  email       String     @unique // e.g. "tan@animuslab.dev"
  displayName String
  role        AdminRole  @default(ANIMUS_ADMIN)
  totpSecret  String?
  status      UserStatus @default(APPROVED)
  createdAt   DateTime   @default(now())

  adminLogs   AdminAuditLog[]
  whitelists  Whitelist[]
  invites     OrgInvite[]
}

model AdminAuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String    // e.g. "CREATE_USER", "APPROVE_USER", "PROVISION_HUB"
  targetId   String?
  targetType String?   // "USER", "HUB", "ORG"
  metadata   Json?
  timestamp  DateTime  @default(now())
}

model AuditTrail {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model AuditorTrail {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "VIEWED_LEDGER", "FILED_NOTICE", "REPLAY_PULL"
  targetId  String?
  timestamp DateTime @default(now())
}

model Whitelist {
  id                 String       @id @default(cuid())
  email              String       @unique
  displayName        String?
  orgName            String?
  orgDomain          String?
  department         String?
  region             String?
  previewClearanceId String?
  source             String?      @default("SELF_REGISTERED_GATEWAY")
  orgId              String
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  hubId              String?
  hub                Hub?         @relation(fields: [hubId], references: [id], onDelete: SetNull)
  role               Role
  invitedBy          String?
  admin              AdminUser?   @relation(fields: [invitedBy], references: [id], onDelete: SetNull)
  status             UserStatus   @default(APPROVED)
  createdAt          DateTime     @default(now())
}

model OrgInvite {
  id         String       @id @default(cuid())
  email      String
  role       Role
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  hubId      String?
  hub        Hub?         @relation(fields: [hubId], references: [id], onDelete: SetNull)
  invitedBy  String
  admin      AdminUser    @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  status     InviteStatus @default(SENT)
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
}

model LedgerEntry {
  id                     String     @id @default(cuid()) // "led_..."
  hubId                  String
  hub                    Hub        @relation(fields: [hubId], references: [id], onDelete: Cascade)
  projectName            String
  entityType             EntityType @default(AI_AGENT)
  timestamp              DateTime   @default(now())
  payload                Json
  chainHash              String
  type                   String     @default("runtime_check")
  signature              String?
  evidenceClassification String     @default("operational")
  parentEntryId          String?
}

model GovernanceAccessRequest {
  id                     String              @id @default(cuid()) // "REQ-..."
  requesterId            String
  requester              User                @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetHubId            String
  targetHub              Hub                 @relation(fields: [targetHubId], references: [id], onDelete: Cascade)
  purposeClassification  String              // e.g. "Forensic Audit"
  justification          String
  requestedCapability    String              @default("can_replay")
  status                 AccessRequestStatus @default(PENDING)
  approverId             String?
  approver               User?               @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)
  temporaryToken         String?
  createdAt              DateTime            @default(now())
  expiresAt              DateTime?

  replayLogs             ReplayAccessLog[]
}

model ReplayAccessLog {
  id         String                  @id @default(cuid()) // "acc_..."
  requestId  String
  request    GovernanceAccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  accessedBy String
  auditor    User                    @relation(fields: [accessedBy], references: [id], onDelete: Cascade)
  accessedAt DateTime                @default(now())
  chainHash  String
}

model EnforcementNotice {
  id           String   @id @default(cuid())
  issuedBy     String
  auditor      User     @relation(fields: [issuedBy], references: [id], onDelete: Cascade)
  hubId        String
  hub          Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  targetEmail  String
  severity     NoticeSeverity @default(MEDIUM)
  noticeText   String
  jurisdiction String
  filedAt      DateTime @default(now())
}

model GovernanceIdentity {
  id                   String   @id @default(cuid())
  projectName          String
  publicKeyPem         String
  publicKeyFingerprint String   @unique
  registeredBy         String?
  registeredAt         DateTime @default(now())
  status               String   @default("ACTIVE")
  hubId                String?
  hub                  Hub?     @relation(fields: [hubId], references: [id], onDelete: SetNull)
}

model TelemetryEvent {
  id                  String           @id @default(cuid())
  hubId               String
  hub                 Hub              @relation(fields: [hubId], references: [id], onDelete: Cascade)
  projectName         String
  entityDisplayName   String?          // e.g. "Forge Repository"
  complianceVerdict   String
  riskScore           Float
  identityFingerprint String
  violationsJson      String
  createdAt           DateTime         @default(now())
  modelId             String?
  model               GovernedAiModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([identityFingerprint])
  @@index([complianceVerdict])
  @@index([modelId])
}

// ═══════════════════════════════════════════════════════
// COMMERCIAL & CONTRACT RECORD (Revision 2.1)
// ═══════════════════════════════════════════════════════

model Quote {
  id                   String          @id @default(cuid())
  referenceNumber      String          @unique // e.g. "ANC-Q-2027-0001"
  orgId                String?
  organization         Organization?   @relation(fields: [orgId], references: [id])

  companyLegalName     String
  companyTradingName   String?
  companyCountry       String
  companyAddress       String?
  companyRegNumber     String?
  companyTaxId         String?         // GSTIN, VAT, EIN
  billingAddress       String?

  contactName          String
  contactDesignation   String?
  contactEmail         String
  contactPhone         String?

  signatoryName        String?
  signatoryDesignation String?
  signatoryEmail       String?
  signatoryIsSameAsContact Boolean     @default(true)

  packageTier          PackageTier
  termYears            Int             @default(1)
  currency             String          @default("USD")
  annualListPrice      Decimal         @db.Decimal(12, 2)
  bundleDiscount       Decimal         @db.Decimal(12, 2)
  termDiscount         Decimal         @db.Decimal(12, 2)
  netAnnualPrice       Decimal         @db.Decimal(12, 2)
  servicesTotal        Decimal         @default(0) @db.Decimal(12, 2)
  taxRate              Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount            Decimal         @default(0) @db.Decimal(12, 2)
  totalContract        Decimal         @db.Decimal(12, 2)

  status               QuoteStatus     @default(DRAFT)
  submittedAt          DateTime?
  expiresAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  lineItems            QuoteLineItem[]
  contracts            Contract[]
}

model QuoteLineItem {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  itemCode       String   // "AI_GOV_CAPACITY_PACK", "DEV_SEATS", "MODEL_SLOT"
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
}

model Contract {
  id                 String              @id @default(cuid())
  referenceNumber    String              @unique // e.g. "ANC-CON-2027-0001"
  quoteId            String
  quote              Quote               @relation(fields: [quoteId], references: [id])
  orgId              String
  organization       Organization        @relation(fields: [orgId], references: [id])
  parentContractId   String?
  parentContract     Contract?           @relation("ContractAmendments", fields: [parentContractId], references: [id])
  amendments         Contract[]          @relation("ContractAmendments")

  version            Int                 @default(1)
  documentHash       String?             // SHA-256 of executed agreement
  documentUrl        String?
  signingProviderRef String?

  commencementDate   DateTime?
  expiryDate         DateTime?
  autoRenew          Boolean             @default(false)

  contractStatus     ContractStatus      @default(DRAFT)
  paymentStatus      PaymentStatus       @default(NOT_DUE)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  signatures         ContractSignature[]
  entitlements       EntitlementGrant[]
  invoices           Invoice[]
  onboardingInvitations OnboardingInvitation[]
}

model ContractSignature {
  id                  String    @id @default(cuid())
  contractId          String
  contract            Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signerName          String
  signerEmail         String
  signerRole          String    // "CUSTOMER_SIGNATORY" | "ANIMUSLAB_OFFICER"
  providerSignatureId String?
  signedAt            DateTime?
  ipAddress           String?
  status              String    @default("PENDING")

  @@unique([contractId, signerRole])
}

model Invoice {
  id              String        @id @default(cuid())
  referenceNumber String        @unique // e.g. "ANC-INV-2027-0001"
  contractId      String
  contract        Contract      @relation(fields: [contractId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  dueDate         DateTime
  paidAt          DateTime?
  status          PaymentStatus @default(INVOICED)
  createdAt       DateTime      @default(now())
}

model EntitlementGrant {
  id                 String            @id @default(cuid())
  orgId              String
  organization       Organization      @relation(fields: [orgId], references: [id])
  hubId              String?           // Null = applies to all Hubs in Org
  hub                Hub?              @relation(fields: [hubId], references: [id])
  contractId         String
  contract           Contract          @relation(fields: [contractId], references: [id])

  featureCode        String            // e.g. "GOVERNED_AI_MODEL_SLOTS"
  aggregationType    EntitlementType   @default(ADDITIVE)
  scope              EntitlementScope  @default(ORGANIZATION)
  limitValue         Int               // -1 = unlimited
  effectiveFrom      DateTime
  effectiveUntil     DateTime
  status             EntitlementStatus @default(PENDING)

  licenseId          String?           @unique // e.g. "ANC-LIC-2027-0001"
  canonicalManifest  String?
  manifestSignature  String?
  signatureAlgorithm String?           @default("ed25519")
  keyId              String?
  issuedAt           DateTime?
  revokedAt          DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([orgId, featureCode, status])
  @@index([contractId])
}

model GovernedAiModel {
  id              String            @id @default(cuid())
  hubId           String
  hub             Hub               @relation(fields: [hubId], references: [id], onDelete: Cascade)
  name            String            // e.g. "Credit-Scoring-Agent"
  slug            String            // e.g. "credit-scoring-agent"
  modelClass      String            // "PROPRIETARY" | "OSS_FINE_TUNE" | "HOSTED_API"
  riskCategory    String            // "HIGH_RISK" | "GPAI_SYSTEMIC" | "MINIMAL"
  status          ModelStatus       @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  modelBindings   ProjectModelBinding[]
  telemetryEvents TelemetryEvent[]

  @@unique([hubId, slug])
}

model ProjectModelBinding {
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelId         String
  model           GovernedAiModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  boundAt         DateTime          @default(now())

  @@id([projectId, modelId])
}

model ProjectScanEvent {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scanHash        String            // SHA-256 of AST findings
  rulesEvaluated  Int
  violationsFound Int
  riskScore       Float
  sanitizedSummary Json
  createdAt       DateTime          @default(now())
}

model OnboardingInvitation {
  id              String       @id @default(cuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  contractId      String
  contract        Contract     @relation(fields: [contractId], references: [id])

  recipientEmail  String
  recipientName   String?
  role            String

  tokenHash       String       @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  revokedBy       String?

  deliveryStatus  String       @default("PENDING")
  deliveredAt     DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, contractId])
  @@index([tokenHash])
}
