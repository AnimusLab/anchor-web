# ============================================================================
# ANCHOR GOVERNANCE SYSTEM - Environment Configuration Template (v6.3)
# ============================================================================
# Copy this file to .env and fill in your environment-specific values.
# NEVER commit the .env file to version control!
# This template documents all required and optional configuration variables.

# ============================================================================
# 1. AUTHENTICATION & SECURITY (CRITICAL SECRETS)
# ============================================================================
# Master key for JWT signing and encryption. MUST be changed in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANCHOR_MASTER_KEY=your_secure_master_key_here_min_32_chars

# TOTP time-step configuration (seconds)
TOTP_STEP=30

# JWT expiry time (now hardened to 30 minutes, see AUTH_HARDENING_v6.3.md)
JWT_EXPIRY_MINUTES=30

# Session management
SESSION_ROTATION_ENABLED=true
FINGERPRINT_VALIDATION_ENABLED=true

# ============================================================================
# 2. DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection (recommended for production)
# Format: postgresql://user:password@host:port/database
# SQLite fallback: sqlite:///./anchor.db
DATABASE_URL=sqlite:///./server/anchor.db

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ============================================================================
# 3. EMAIL & COMMUNICATIONS
# ============================================================================
# Brevo (formerly Sendinblue) API key for email notifications
BREVO_API_KEY=your_brevo_api_key_here

# Email sender configuration
FROM_EMAIL=noreply@anchorgovernance.tech
FROM_NAME=Anchor Governance System

# Email backend (sendgrid, brevo, smtp)
EMAIL_BACKEND=brevo

# ============================================================================
# 4. APPLICATION CONFIGURATION
# ============================================================================
# Base URL for the application (used in email links, CORS, etc.)
ANCHOR_BASE_URL=https://api.anchorgovernance.tech

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (NEVER enable in production)
DEBUG=false

# FastAPI app configuration
APP_NAME=Anchor Governance System
APP_VERSION=6.3.0

# ============================================================================
# 5. MESH & SPOKE NODE CONFIGURATION
# ============================================================================
# Hub/Spoke network settings
HUB_ID=MASTER-HUB-001
REGIONAL_KEY=your_regional_key_here
HUB_URL=wss://api.anchorgovernance.tech/ws/spoke
MAT=master_activation_token_here

# Spoke node configuration (if running as spoke)
SPOKE_HUB_ID=
SPOKE_REGIONAL_KEY=
SPOKE_HUB_URL=

# ============================================================================
# 6. GOVERNANCE & COMPLIANCE
# ============================================================================
# Oversight configuration
OVERSIGHT_JWT_TTL_HOURS=8

# Audit logging configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=server/logs/auth_audit.log
AUDIT_LOG_RETENTION_DAYS=90

# Entity visibility filtering (Anchor v6.3)
ENTITY_VISIBILITY_FILTERING_ENABLED=true
REGULATORY_AUDITOR_RESTRICTIONS_ENABLED=true

# ============================================================================
# 7. SECRET ROTATION (Anchor v6.3)
# ============================================================================
# Enable automatic secret rotation
SECRET_ROTATION_ENABLED=false

# Rotation schedule (in days)
MASTER_KEY_ROTATION_DAYS=90
JWT_KEY_ROTATION_DAYS=30
DB_CREDENTIAL_ROTATION_DAYS=180

# Rotation notification email
SECRET_ROTATION_NOTIFY_EMAIL=security@anchorgovernance.tech

# ============================================================================
# 8. CORS & SECURITY HEADERS
# ============================================================================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://api.anchorgovernance.tech

# HSTS configuration
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Content Security Policy
CSP_ENABLED=true
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ============================================================================
# 9. FEATURE FLAGS
# ============================================================================
# New features that can be toggled
FEATURE_SESSION_FINGERPRINTING=true
FEATURE_AUDIT_LOGGING=true
FEATURE_ENTITY_TAXONOMY=true
FEATURE_WHITELIST_ENFORCEMENT=true

# ============================================================================
# 10. THIRD-PARTY SERVICES (Optional)
# ============================================================================
# Sentry error tracking
SENTRY_DSN=

# DataDog monitoring
DATADOG_API_KEY=

# MaxMind GeoIP (for geo-anomaly detection)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
# Development:
#   - Use sqlite:/// for DATABASE_URL
#   - Set ENVIRONMENT=development
#   - Set DEBUG=true for development only
#   - Generate new ANCHOR_MASTER_KEY

# Staging:
#   - Use PostgreSQL for DATABASE_URL
#   - Set ENVIRONMENT=staging
#   - Set DEBUG=false
#   - Rotate secrets before each staging deployment

# Production:
#   - Use PostgreSQL with connection pooling
#   - Set ENVIRONMENT=production
#   - Set DEBUG=false
#   - Rotate all secrets before production deployment
#   - Use environment-specific AWS Secrets Manager or HashiCorp Vault
#   - Enable SECRET_ROTATION_ENABLED=true
#   - Enable AUDIT_LOG_ENABLED=true with log aggregation (ELK, DataDog, etc.)
#   - Enable ENTITY_VISIBILITY_FILTERING_ENABLED=true
