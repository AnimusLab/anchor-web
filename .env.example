# ==============================================================================
# Anchor Enterprise Hub - Production Environment Configuration Template
# All secret values must be high-entropy, cryptographically generated strings.
# ==============================================================================

# --- Server & Environment ---
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://hub.your-domain.com

# --- Cryptographic Session Security ---
# Secret key used for signing HS256 JWT session tokens (Min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_character_string_minimum

# --- Database Storage ---
# PostgreSQL 16 connection string (Neon, AWS RDS, or local container)
DATABASE_URL=postgresql://anchor_admin:your_secure_password@anchor-db:5432/anchor_hub?schema=public

# --- Optional External Services ---
# Transactional email for OTP and auditor invitation links
RESEND_API_KEY=re_your_resend_api_key_here

# --- Telemetry & Audit Integrity ---
# Maximum clock drift tolerance for asymmetric Ed25519 packet timestamps (in seconds)
MAX_TELEMETRY_CLOCK_SKEW_SEC=300
